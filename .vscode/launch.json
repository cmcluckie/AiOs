{
  // Press play.  Each flavor is an entry in the Run and Debug dropdown; F5 runs
  // the selected one.  Not a debugger yet: it runs jig/aios in a terminal.
  // A real debugger (GDB attached to QEMU) needs a tool-table row first.
  "version": "0.2.0",
  "configurations": [
    { "name": "AiOS: hello",  "type": "node-terminal", "request": "launch", "cwd": "${workspaceFolder}",
      "command": "sh jig/aios run hello",  "windows": { "command": "wsl sh jig/aios run hello" } },
    { "name": "AiOS: hanoi",  "type": "node-terminal", "request": "launch", "cwd": "${workspaceFolder}",
      "command": "sh jig/aios run hanoi",  "windows": { "command": "wsl sh jig/aios run hanoi" } },
    { "name": "AiOS: life",   "type": "node-terminal", "request": "launch", "cwd": "${workspaceFolder}",
      "command": "sh jig/aios run life",   "windows": { "command": "wsl sh jig/aios run life" } },
    { "name": "AiOS: calc",   "type": "node-terminal", "request": "launch", "cwd": "${workspaceFolder}",
      "command": "sh jig/aios run calc",   "windows": { "command": "wsl sh jig/aios run calc" } },
    { "name": "AiOS: stopwatch", "type": "node-terminal", "request": "launch", "cwd": "${workspaceFolder}",
      "command": "sh jig/aios run stopwatch", "windows": { "command": "wsl sh jig/aios run stopwatch" } },
    { "name": "AiOS: sort", "type": "node-terminal", "request": "launch", "cwd": "${workspaceFolder}",
      "command": "sh jig/aios run sort", "windows": { "command": "wsl sh jig/aios run sort" } },
    { "name": "AiOS: share (two at once)", "type": "node-terminal", "request": "launch", "cwd": "${workspaceFolder}",
      "command": "sh jig/aios run share", "windows": { "command": "wsl sh jig/aios run share" } },
    { "name": "AiOS: both (refused: loader@1 runs one)", "type": "node-terminal", "request": "launch", "cwd": "${workspaceFolder}",
      "command": "sh jig/aios check both", "windows": { "command": "wsl sh jig/aios check both" } },
    { "name": "AiOS: pick a flavor", "type": "node-terminal", "request": "launch", "cwd": "${workspaceFolder}",
      "command": "sh jig/aios run ${input:flavor}", "windows": { "command": "wsl sh jig/aios run ${input:flavor}" } }
  ],
  "inputs": [
    { "id": "flavor", "type": "pickString", "description": "Which flavor?", "options": ["hello", "gate", "hanoi", "life", "calc", "stopwatch", "sort", "share", "both"], "default": "hello" }
  ]
}
