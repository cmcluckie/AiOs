#!/bin/sh
# model: one call to one model on Amazon Bedrock (the Converse API), signed by
# curl's own AWS signing, with every call checked against the spending cap
# first and written into the run record (jig/runs) after.  It is the only thing
# in the exam that reaches the network, and it decides nothing about a lift.
#
#   model ping            ask for one word back; prints the word, the tokens
#                         and what the call cost.  The first thing run, to prove
#                         the key, the policy and the model id work.
#
# The key is read from ~/.aios/aws (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_REGION), a file outside the repo; AIOS_AWS=file points elsewhere.  The
# model is MODEL_NAME (the row in jig/prices.toml, default the Sonnet row) and
# MODEL_ID (the Bedrock id to call, default its global profile).
# MODEL_FAKE=file reads a saved reply from that file and calls nothing (tests).
# Exit 0 answered, 1 refused (reason on stderr), 2 cannot run here.
set -u
repo=$(cd "$(dirname "$0")/.." && pwd)
MODEL_NAME=${MODEL_NAME:-bedrock:global.anthropic.claude-sonnet-5-5}
MODEL_ID=${MODEL_ID:-global.anthropic.claude-sonnet-5-5}
AIOS_AWS=${AIOS_AWS:-$HOME/.aios/aws}
MODEL_MAX_COST=${MODEL_MAX_COST:-0.05}
die() { echo "model: $*" >&2; exit 1; }
cannot() { echo "model: $*" >&2; exit 2; }

# the first value of "NAME":NUMBER or "NAME":"text" in a reply
number() { sed -n "s/.*\"$1\" *: *\([0-9][0-9]*\).*/\1/p" "$2" | head -n 1; }
text() { sed -n 's/.*"text" *: *"\(\([^"\\]\|\\.\)*\)".*/\1/p' "$1" | head -n 1; }

call() {	# call IN OUT: IN is the request body, OUT gets the reply
	if [ -n "${MODEL_FAKE:-}" ]; then cp "$MODEL_FAKE" "$2" || cannot "no fake reply at $MODEL_FAKE"; return 0; fi
	command -v curl > /dev/null || cannot "curl is not installed"
	[ -f "$AIOS_AWS" ] || cannot "no key file at $AIOS_AWS"
	[ -z "$(find "$AIOS_AWS" -perm /077 2> /dev/null)" ] || die "$AIOS_AWS can be read by others; chmod 600 it"
	# shellcheck disable=SC1090
	. "$AIOS_AWS"
	: "${AWS_ACCESS_KEY_ID:?}" "${AWS_SECRET_ACCESS_KEY:?}" "${AWS_REGION:?}"
	code=$(curl -sS -o "$2" -w '%{http_code}' --max-time 120 \
		--aws-sigv4 "aws:amz:$AWS_REGION:bedrock" --user "$AWS_ACCESS_KEY_ID:$AWS_SECRET_ACCESS_KEY" \
		-H 'content-type: application/json' --data-binary "@$1" \
		"https://bedrock-runtime.$AWS_REGION.amazonaws.com/model/$MODEL_ID/converse") || cannot "curl could not reach Bedrock"
	[ "$code" = 200 ] || die "Bedrock said $code: $(head -c 300 "$2")"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
ping)	tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
	grep -q "^name *= *\"$MODEL_NAME\"" "${PRICES:-$repo/jig/prices.toml}" 2> /dev/null || die "no price for $MODEL_NAME: not calling a model whose calls cannot be costed"
	sh "$repo/jig/runs" budget "$MODEL_MAX_COST" > /dev/null || exit 1
	printf '%s\n' 'Say the single word: ready' > "$tmp/in.txt"
	printf '{"messages":[{"role":"user","content":[{"text":"Say the single word: ready"}]}],"inferenceConfig":{"maxTokens":20}}' > "$tmp/req.json"
	call "$tmp/req.json" "$tmp/out.json"
	tin=$(number inputTokens "$tmp/out.json"); tout=$(number outputTokens "$tmp/out.json"); word=$(text "$tmp/out.json")
	[ -n "$tin" ] && [ -n "$tout" ] || die "the reply has no token counts: $(head -c 200 "$tmp/out.json")"
	[ -n "$word" ] || die "the reply has no text: $(head -c 200 "$tmp/out.json")"
	printf '%s\n' "$word" > "$tmp/out.txt"
	id=$(sh "$repo/jig/runs" record ping "$MODEL_NAME" "$(date -u +%Y-%m-%d)" 1 "$tin" "$tout" pass 0 "$tmp/in.txt" "$tmp/out.txt") || exit 1
	echo "reply: $word"
	echo "tokens: $tin in, $tout out"
	echo "cost: $(sed -n 's/^cost_usd *= *//p' "${RUNS:-$repo/runs}/$id/run.toml")"
	echo "recorded: $id" ;;
*)	die "unknown command '$cmd'; see the top of jig/model" ;;
esac
