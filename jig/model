#!/bin/sh
# model: one call to one model on Amazon Bedrock (the Converse API), signed by
# curl's own AWS signing, with every call checked against the spending cap
# first and written into the run record (jig/runs) after.  It is the only thing
# in the exam that reaches the network, and it decides nothing about a lift.
#
#   model converse REQ OUT   one call with the request body in REQ (Converse JSON); the reply
#                         is written to OUT; refused first if the model has no price or the
#                         cap has no room
#   model ping            ask for one word back; prints the word, the tokens
#                         and what the call cost.  The first thing run, to prove
#                         the key, the policy and the model id work.
#
# The key is read from ~/.aios/aws (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_REGION), a file outside the repo; AIOS_AWS=file points elsewhere.  The
# model is MODEL_NAME (the row in jig/prices.toml, default the Sonnet 4.6 row) and
# MODEL_ID (the Bedrock id to call, default its global profile).
# MODEL_FAKE=file reads a saved reply from that file and calls nothing (tests); a folder
# of 1.json, 2.json, ... hands them out in order.
# A model named ollama:NAME is called on a local Ollama instead (OLLAMA_URL, default
# http://localhost:11434; on the jig, the ssh tunnel from the machine with the card).
# The Converse request is handed over as one Ollama chat and the reply handed back in
# Converse's shape, so nothing else in the exam changes.  The context size
# (MODEL_NUM_CTX, default 32768) and the reply's limit are set on each request, never
# in Ollama's own settings.  No key: Ollama on the machine it runs on asks for none.
# OLLAMA_FAKE=file stands in for Ollama's reply and OLLAMA_SENT=file keeps what would
# have been sent (tests).
# Exit 0 answered, 1 refused (reason on stderr), 2 cannot run here.
set -u
repo=$(cd "$(dirname "$0")/.." && pwd)
MODEL_NAME=${MODEL_NAME:-bedrock:global.anthropic.claude-sonnet-4-6}
MODEL_ID=${MODEL_ID:-global.anthropic.claude-sonnet-4-6}
AIOS_AWS=${AIOS_AWS:-$HOME/.aios/aws}
MODEL_MAX_COST=${MODEL_MAX_COST:-0.05}
die() { echo "model: $*" >&2; exit 1; }
cannot() { echo "model: $*" >&2; exit 2; }

# the first value of "NAME":NUMBER or "NAME":"text" in a reply
number() { sed -n "s/.*\"$1\" *: *\([0-9][0-9]*\).*/\1/p" "$2" | head -n 1; }
text() { sed -n 's/.*"text" *: *"\(\([^"\\]\|\\.\)*\)".*/\1/p' "$1" | head -n 1; }

guard() {	# nothing is called for a model with no price, or past the cap
	grep -q "^name *= *\"$MODEL_NAME\"" "${PRICES:-$repo/jig/prices.toml}" 2> /dev/null || die "no price for $MODEL_NAME: not calling a model whose calls cannot be costed"
	sh "$repo/jig/runs" budget "$MODEL_MAX_COST" > /dev/null || exit 1
}

# the Converse request IN as one Ollama chat: the system prompt first, every earlier
# tool call and its answer handed back as such, the tools offered, the context size and
# the reply's limit on the request
to_ollama() {
	jq --arg model "${MODEL_NAME#ollama:}" --argjson ctx "${MODEL_NUM_CTX:-32768}" '
		([.messages[].content[]? | select(.toolUse) | .toolUse | {key: .toolUseId, value: .name}] | from_entries) as $names
		| {model: $model, stream: false, keep_alive: "10m",
		   options: ({num_ctx: $ctx} + (if .inferenceConfig.maxTokens then {num_predict: .inferenceConfig.maxTokens} else {} end)),
		   messages: (
			([(.system // [])[] | select(.text) | .text] | if length > 0 then [{role: "system", content: join("\n")}] else [] end)
			+ ([.messages[] as $m |
				if $m.role == "assistant" then
					[{role: "assistant", content: ([$m.content[] | select(.text) | .text] | join("\n"))}
					 + ([$m.content[] | select(.toolUse) | {function: {name: .toolUse.name, arguments: .toolUse.input}}]
					    | if length > 0 then {tool_calls: .} else {} end)]
				else
					[$m.content[] | select(.toolResult) | {role: "tool", tool_name: $names[.toolResult.toolUseId],
						content: ([.toolResult.content[]? | .text // ""] | join("\n"))}]
					+ ([$m.content[] | select(.text) | .text] | if length > 0 then [{role: "user", content: join("\n")}] else [] end)
				end] | add // []))}
		+ (if .toolConfig then {tools: [.toolConfig.tools[].toolSpec | {type: "function",
			function: {name, description, parameters: .inputSchema.json}}]} else {} end)' "$1"
}

# Ollama's reply IN in Converse's shape: its text, its tool calls (each given an id
# from the reply's time and its place, since Ollama gives none), its own token counts,
# and a reply cut off at its limit (done_reason length) as max_tokens, as Bedrock says it
# (decision 0086).  A thinking model's thinking is not kept; its tokens are in the count
from_ollama() {
	jq '(.message.tool_calls // []) as $tc
		| (.created_at // "0" | gsub("[^0-9]"; "")) as $t
		| {output: {message: {role: "assistant", content: (
			(if (.message.content // "") != "" then [{text: .message.content}] else [] end)
			+ [$tc | to_entries[] | {toolUse: {toolUseId: ("ollama-" + $t + "-" + (.key | tostring)), name: .value.function.name,
				input: (.value.function.arguments | if type == "string" then (fromjson? // {}) else . end)}}])}},
		   stopReason: (if ($tc | length) > 0 then "tool_use" elif .done_reason == "length" then "max_tokens" else "end_turn" end),
		   usage: {inputTokens: (.prompt_eval_count // 0), outputTokens: (.eval_count // 0),
			   totalTokens: ((.prompt_eval_count // 0) + (.eval_count // 0))}}' "$1"
}

call_ollama() {	# call_ollama IN OUT
	command -v jq > /dev/null || cannot "jq is not installed"
	to_ollama "$1" > "$2.sent" || die "the request could not be handed over as an Ollama chat"
	[ -n "${OLLAMA_SENT:-}" ] && cp "$2.sent" "$OLLAMA_SENT"
	if [ -n "${OLLAMA_FAKE:-}" ]; then cp "$OLLAMA_FAKE" "$2.raw" || cannot "no fake Ollama reply at $OLLAMA_FAKE"
	else
		command -v curl > /dev/null || cannot "curl is not installed"
		code=$(curl -sS -o "$2.raw" -w '%{http_code}' --max-time 1800 -H 'content-type: application/json' \
			--data-binary "@$2.sent" "${OLLAMA_URL:-http://localhost:11434}/api/chat" 2> /dev/null) || { rm -f "$2.sent" "$2.raw"; cannot "could not reach Ollama at ${OLLAMA_URL:-http://localhost:11434}"; }
		[ "$code" = 200 ] || die "Ollama said $code: $(head -c 300 "$2.raw")"
	fi
	from_ollama "$2.raw" > "$2" || die "Ollama's reply could not be read: $(head -c 200 "$2.raw")"
	rm -f "$2.sent" "$2.raw"
}

call() {	# call IN OUT: IN is the request body, OUT gets the reply
	case "$MODEL_NAME" in ollama:*) call_ollama "$1" "$2"; return ;; esac
	if [ -d "${MODEL_FAKE:-}" ]; then	# a folder of saved replies, 1.json, 2.json, ... handed out in order
		n=$(cat "$MODEL_FAKE/.n" 2> /dev/null || echo 0); n=$((n + 1)); echo "$n" > "$MODEL_FAKE/.n"
		cp "$MODEL_FAKE/$n.json" "$2" 2> /dev/null || cannot "no saved reply number $n in $MODEL_FAKE"; return 0
	fi
	if [ -n "${MODEL_FAKE:-}" ]; then cp "$MODEL_FAKE" "$2" || cannot "no fake reply at $MODEL_FAKE"; return 0; fi
	command -v curl > /dev/null || cannot "curl is not installed"
	[ -f "$AIOS_AWS" ] || cannot "no key file at $AIOS_AWS"
	[ -z "$(find "$AIOS_AWS" -perm /077 2> /dev/null)" ] || die "$AIOS_AWS can be read by others; chmod 600 it"
	# shellcheck disable=SC1090
	. "$AIOS_AWS"
	: "${AWS_ACCESS_KEY_ID:?}" "${AWS_SECRET_ACCESS_KEY:?}" "${AWS_REGION:?}"
	code=$(curl -sS -o "$2" -w '%{http_code}' --max-time 600 \
		--aws-sigv4 "aws:amz:$AWS_REGION:bedrock" --user "$AWS_ACCESS_KEY_ID:$AWS_SECRET_ACCESS_KEY" \
		-H 'content-type: application/json' --data-binary "@$1" \
		"https://bedrock-runtime.$AWS_REGION.amazonaws.com/model/$MODEL_ID/converse") || cannot "curl could not reach Bedrock"
	[ "$code" = 200 ] || die "Bedrock said $code: $(head -c 300 "$2")"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
ping)	tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
	guard
	printf '%s\n' 'Say the single word: ready' > "$tmp/in.txt"
	printf '{"messages":[{"role":"user","content":[{"text":"Say the single word: ready"}]}],"inferenceConfig":{"maxTokens":20}}' > "$tmp/req.json"
	call "$tmp/req.json" "$tmp/out.json"
	tin=$(number inputTokens "$tmp/out.json"); tout=$(number outputTokens "$tmp/out.json"); word=$(text "$tmp/out.json")
	[ -n "$tin" ] && [ -n "$tout" ] || die "the reply has no token counts: $(head -c 200 "$tmp/out.json")"
	[ -n "$word" ] || die "the reply has no text: $(head -c 200 "$tmp/out.json")"
	printf '%s\n' "$word" > "$tmp/out.txt"
	id=$(sh "$repo/jig/runs" record ping "$MODEL_NAME" "$(date -u +%Y-%m-%d)" 1 "$tin" "$tout" pass 0 "$tmp/in.txt" "$tmp/out.txt") || exit 1
	echo "reply: $word"
	echo "tokens: $tin in, $tout out"
	echo "cost: $(sed -n 's/^cost_usd *= *//p' "${RUNS:-$repo/runs}/$id/run.toml")"
	echo "recorded: $id" ;;
converse)	[ $# -eq 2 ] || die "needs REQUEST_FILE REPLY_FILE"
	[ -f "$1" ] || die "$1 is not a file"
	guard; call "$1" "$2" ;;
*)	die "unknown command '$cmd'; see the top of jig/model" ;;
esac
