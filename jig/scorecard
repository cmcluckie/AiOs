#!/bin/sh
# scorecard: the exam's results, one block per model, from the recorded runs
# (jig/runs) and nothing else.  For each exam item (exam/items.toml) it shows
# whether the model passed, the lines of code its lift kept beside the hand
# lift's (counted the same way for both), the tries it took and what every try
# cost, failed ones included; an item the model never sat is "not sat".  Each
# start of the runner is a sitting and gets a line of its own, with the
# fingerprint of the prompt it was given, so that two runs of one item are
# never added together into one pass.  A sitting on the layered agent's bench
# (findings 0027) also shows the bench, the most context one call held, and how
# its last try ended: a pass, out of room, stuck and the rest.  Dollars are shown
# and never graded.  It decides nothing and invents nothing:
# a number that is not in runs/ or in the hand lift's file is not on the card.
#
#   scorecard                 every model that has a run
#
# RUNS=dir (default runs/), EXAM=file (default exam/items.toml), EXAM_ROOT=dir
# (default the repo; where the items' hand-lift paths start).
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
RUNS=${RUNS:-$repo/runs}
EXAM=${EXAM:-$repo/exam/items.toml}
EXAM_ROOT=${EXAM_ROOT:-$repo}
die() { echo "scorecard: $*" >&2; exit 1; }
[ -f "$EXAM" ] || die "no exam at $EXAM"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

# the items in the order the exam lists them, each with the hand lift's code lines
awk '/^\[\[item\]\]/ { if (n != "") print n "\t" h; n = ""; h = "" }
	/^name *=/ { s = $0; sub(/^[^"]*"/, "", s); sub(/".*$/, "", s); n = s }
	/^hand *=/ { s = $0; sub(/^[^"]*"/, "", s); sub(/".*$/, "", s); h = s }
	END { if (n != "") print n "\t" h }' "$EXAM" > "$tmp/items.raw"
[ -s "$tmp/items.raw" ] || die "$EXAM lists no items"
while IFS="$(printf '\t')" read -r name hand; do
	files=""; for f in $hand; do case "$f" in *.c) files="$files $EXAM_ROOT/$f" ;; esac; done
	[ -n "$files" ] || die "item $name has no hand-lift .c file"
	# shellcheck disable=SC2086
	printf '%s\t%s\n' "$name" "$(sh "$repo/jig/runs" count $files)"
done < "$tmp/items.raw" > "$tmp/items"

# every run, one line each: model, version, item, sitting, try, result, lines, cost, prompt,
# and on the agent's bench, bench, peak context and how it ended
for f in "$RUNS"/*/run.toml; do
	[ -f "$f" ] || continue
	awk 'function val(s) { sub(/^[^=]*= */, "", s); gsub(/"/, "", s); return s }
		/^id *=/ { id = val($0) } /^sitting *=/ { st = val($0) } /^prompt *=/ { pr = val($0) }
		/^model *=/ { m = val($0) } /^version *=/ { v = val($0) } /^item *=/ { i = val($0) }
		/^try *=/ { t = val($0) } /^result *=/ { r = val($0) } /^lines *=/ { l = val($0) } /^cost_usd *=/ { c = val($0) }
		/^bench *=/ { b = val($0) } /^peak_context *=/ { pk = val($0) } /^ended *=/ { e = val($0) }
		END { if (st == "") { st = id; sub(/-.*/, "", st) } if (pr == "") pr = "-"
			printf "%s\t%s\t%s\t%s\t%d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", m, v, i, st, t, r, l, c, pr, b, pk, e }' "$f"
done | sort -t"$(printf '\t')" -k1,1 -k2,2 -k3,3 -k4,4 -k5,5n > "$tmp/runs"
[ -s "$tmp/runs" ] || { echo "no runs recorded in $RUNS"; exit 0; }

# a sitting is one start of the runner: up to three tries, shown as one line with the cost of all of them
awk -F'\t' '
FILENAME == ITEMS { order[++n] = $1; hand[$1] = $2; next }
{ key = $1 " (" $2 ")"; if (!(key in seen)) { seen[key] = 1; models[++nm] = key }
  k = key SUBSEP $3; sk = k SUBSEP $4
  if (!(sk in sn)) { ns[k]++; sid[k, ns[k]] = $4; spr[sk] = $9 }
  sn[sk]++; sc[sk] += $8
  if ($10 != "") { sb[sk] = $10; if ($11 + 0 > spk[sk]) spk[sk] = $11 + 0; se[sk] = $12 }
  if ($6 == "pass" && !(sk in sp)) { sp[sk] = 1; sl[sk] = $7 } }
END {
	for (m = 1; m <= nm; m++) {
		print models[m]; ok = 0; total = 0; nsit = 0; npass = 0; passcost = 0
		for (i = 1; i <= n; i++) {
			k = models[m] SUBSEP order[i]; got = 0
			if (ns[k] == 0) { printf "  %-7s not sat\n", order[i]; continue }
			for (j = 1; j <= ns[k]; j++) {
				sk = k SUBSEP sid[k, j]; nsit++; total += sc[sk]
				tries = sprintf("%d %s", sn[sk], (sn[sk] == 1 ? "try" : "tries"))
				bench = (sk in sb) ? sprintf("  bench %s, peak context %d, ended %s", sb[sk], spk[sk], (se[sk] == "" ? "-" : se[sk])) : ""
				if (sk in sp) {
					npass++; passcost += sc[sk]; got = 1
					printf "  %-7s PASS  %d lines (hand %d)  %s  $%.6f  prompt %s%s\n", order[i], sl[sk], hand[order[i]], tries, sc[sk], spr[sk], bench
				} else
					printf "  %-7s FAIL  %s  $%.6f  prompt %s%s\n", order[i], tries, sc[sk], spr[sk], bench
			}
			ok += got
		}
		if (npass > 0) per = sprintf("$%.6f", passcost / npass); else per = "n/a"
		printf "  %d of %d items passed  %d %s, %d passed\n", ok, n, nsit, (nsit == 1 ? "sitting" : "sittings"), npass
		printf "  $%.6f spent  %s per passing sitting\n", total, per
	}
}' ITEMS="$tmp/items" "$tmp/items" "$tmp/runs"

# the layered bench by part (findings 0029): one line per start of a director, its
# part and how it went, a prompt trial's runs marked and shown together
for f in "$RUNS"/*/run.toml; do
	[ -f "$f" ] || continue
	awk 'function val(s) { sub(/^[^=]*= */, "", s); gsub(/"/, "", s); return s }
		/^item *=/ { i = val($0) } /^sitting *=/ { st = val($0) } /^prompt *=/ { pr = val($0) }
		/^model *=/ { m = val($0) } /^result *=/ { r = val($0) } /^ended *=/ { e = val($0) } /^trial *=/ { tr = val($0) }
		END { if (i ~ /^direct-/) printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n", (tr == "" ? "~" : tr), substr(i, 8), st, m, pr, r, e }' "$f"
done | sort > "$tmp/parts"
if [ -s "$tmp/parts" ]; then
	echo
	echo "The layered bench, by part"
	awk -F'\t' '{ if ($1 != "~" && $1 != last) printf "  prompt trial %s\n", $1; last = $1
		printf "  %s%-14s %s  director prompt %s  %s  ended %s  sitting %s\n", ($1 == "~" ? "" : "  "), $2, $4, $5, toupper($6), $7, $3 }' "$tmp/parts"
fi
