#!/bin/sh
# aios: the referee and the builder, as one shell script, until they are real
# components (plan sections 3 and 5).  POSIX sh only; reads the repo's TOML with
# sed, which is enough for the flat files the schema allows.
#
#   aios list                 flavors and petitions in this repo
#   aios check <flavor>       referee: every code in every petition resolves,
#                             and the flavor is one the builder can make
#   aios build <flavor>       builder: collect the components, compile, image
#   aios run <flavor>         check, build, boot on the flavor's machine
#   aios pack <archive> <name> <file>...   programs into one cpio archive, in
#                             order, the way build does for a flavor of several
#   aios rules                referee: rules 2 to 8 of schema/petition.md, on
#                             every petition, written to tests/referee-results.txt;
#                             any FAIL exits 1
#   aios lines <file>         referee: a committee's or mechanic's output is a
#                             numbered list, one verb-noun line each; the verb
#                             is in constitution/verbs.toml, the noun is a
#                             catalogue number; anything else is refused
#   aios ledger [--cached | --commit REV]
#                             referee: every change to something only a human
#                             decides (constitution/human-only.toml) is named by
#                             a decision in decisions/ in the same change, by a
#                             key in constitution/keys/.  --cached checks what is
#                             staged (the pre-commit hook); --commit checks one
#                             commit as made (jig/test, on every commit since the
#                             last run); without either, everything changed since
#                             the last commit, untracked included.
#
# Failures name codes, never tool output.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo"

die() { printf 'refused: %s\n' "$*" >&2; exit 1; }
field() { sed -n "s/^$2 *= *\"\([^\"]*\)\".*/\1/p" "$1" | head -1; }
list_field() { sed -n "s/^$2 *= *\[\(.*\)\].*/\1/p" "$1" | tr ',' '\n' | sed 's/[" ]//g' | grep . || true; }

# code -> file.  PART.loader@1 -> index/part/loader@1.toml
code_file() {
	t=${1%%.*}; rest=${1#*.}
	case "$rest" in *@*) ;; *) rest="$rest@1" ;; esac
	case "$t" in
		PUR)  echo "constitution/purposes/$rest.toml" ;;
		KEY)  echo "constitution/keys/$rest.toml" ;;
		CAP)  echo "index/cap/$rest.toml" ;;
		PART) echo "index/part/$rest.toml" ;;
		MACHINE) echo "index/machine/$rest.toml" ;;
		TOOL) echo "index/tool/$rest.toml" ;;
		SPEC) echo "specs/$rest.toml" ;;
		TST)  echo "tests/$rest.toml" ;;
		SNS)  echo "sensors/$rest.toml" ;;
		FND)  echo "findings/${rest%@*}.md" ;;
		*)    echo "" ;;
	esac
}

# every code mentioned anywhere in a petition file
petition_codes() {
	sed -n 's/.*"\(\(PUR\|KEY\|CAP\|PART\|MACHINE\|TOOL\|SPEC\|TST\|SNS\|FND\)\.[a-z0-9.-]*\(@[0-9]*\)\?\)".*/\1/p' "$1" | sort -u
}

petition_primary() {
	awk '/^\[\[component\]\]/{c="";r=""} /^code/{gsub(/[" ]/,"",$3);c=$3} /^role/{gsub(/[" ]/,"",$3);r=$3; if(r=="primary")print c}' "$1"
}

flavor_file() { f="flavors/$1.toml"; [ -f "$f" ] || die "no flavor named $1"; echo "$f"; }

cmd_list() {
	echo "flavors:";   for f in flavors/*.toml; do printf '  %-8s petitions %s\n' "$(field "$f" name)" "$(list_field "$f" petitions | tr '\n' ' ')"; done
	echo "petitions:"; for p in petitions/*.toml; do printf '  %s  %s  %s\n' "$(field "$p" id)" "$(field "$p" status)" "$(field "$(code_file "$(field "$p" purpose)")" sentence)"; done
}

# referee, phase 1: well-formed.  Phase 2 (buildable) needs admissions, which do not exist yet.
cmd_check() {
	f=$(flavor_file "$1")
	machine=$(field "$f" machine)
	[ -f "$(code_file "$machine")" ] || die "missing $machine"
	primaries=""
	for id in $(list_field "$f" petitions); do
		p="petitions/$id.toml"; [ -f "$p" ] || die "missing petition $id"
		for code in $(petition_codes "$p"); do
			cf=$(code_file "$code")
			[ -n "$cf" ] || die "rule 1: $code is not a catalogue number"
			[ -f "$cf" ] || die "rule 1: missing $code (petition $id)"
			[ "$(field "$cf" code)" = "${code%@*}@${code#*@}" ] || [ "$(field "$cf" code)" = "$code@1" ] || true
		done
		exp=$(sed -n 's/^expires *= *\([0-9-]*\).*/\1/p' "$p")
		[ "$exp" \> "$(date +%Y-%m-%d)" ] || die "rule 9: petition $id expired $exp"
		pending=$(awk '/^admitted *= *false/{n++} END{print n+0}' "$p")
		primaries="$primaries $(petition_primary "$p")"
		printf 'petition %s: well-formed, %s component(s) pending admission\n' "$id" "$pending"
	done
	n=$(echo $primaries | wc -w)
	if [ "$n" -gt 1 ]; then
		# more than one program: the newest loader any of them asks for must share the processor
		loader=$(loader_for $primaries)
		list_field "$(code_file "$loader")" exposes | grep -q '^CAP\.cpu\.share@' ||
			die "flavor $1 needs $n programs on one machine; $loader runs one (CAP.cpu.share, plan 9.6)"
	fi
	printf 'flavor %s: buildable on %s, program %s\n' "$1" "$machine" "$primaries"
}

# the loader for a set of programs: the newest one any of them depends on
loader_for() {
	for p in "$@"; do list_field "$(code_file "$p")" depends; done | sort -t@ -k2,2n | tail -1
}

# newc ARCHIVE NAME FILE...: a cpio archive in the "new ASCII" format (magic 070701),
# the one Linux's initramfs uses, one regular file per program, in order.
newc() {
	arc=$1; shift; : > "$arc"; ino=1
	pad() { n=$(( (4 - $(wc -c < "$arc") % 4) % 4 )); [ $n -eq 0 ] || head -c $n /dev/zero >> "$arc"; }
	hdr() {	# name size mode
		printf '070701%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X' \
			$ino $3 0 0 1 0 $2 0 0 0 0 $(( ${#1} + 1 )) 0 >> "$arc"
		printf '%s\0' "$1" >> "$arc"; pad; ino=$((ino + 1))
	}
	while [ $# -gt 0 ]; do
		hdr "$1" "$(wc -c < "$2")" $((0100644)); cat "$2" >> "$arc"; pad; shift 2
	done
	hdr TRAILER!!! 0 0
}

cmd_build() {
	cmd_check "$1" >/dev/null
	f=$(flavor_file "$1")
	progs=$(for id in $(list_field "$f" petitions); do petition_primary "petitions/$id.toml"; done)
	# walk run-time depends from the programs down; the loader is the newest any of them depends on
	for prog in $progs; do [ -n "$(list_field "$(code_file "$prog")" depends)" ] || die "$prog depends on nothing; a program needs a loader"; done
	loader=$(loader_for $progs)
	ldir=$(field "$(code_file "$loader")" source)
	ddirs=""	# everything the loader depends on (lifted parts), built into it
	for dep in $(list_field "$(code_file "$loader")" depends); do
		ddirs="$ddirs $(field "$(code_file "$dep")" source)"
	done
	for d in "$ldir" $ddirs; do [ -d "$d" ] || die "source $d is not in the pool"; done
	out="out/$1"; mkdir -p "$out"
	CC=${CC:-gcc}
	CFLAGS="-m32 -std=c11 -ffreestanding -fno-pic -fno-pie -fno-stack-protector -fno-builtin -fno-asynchronous-unwind-tables -mno-sse -mno-mmx -mno-red-zone -mgeneral-regs-only -nostdlib -nostdinc -O2 -Wall -Wextra -Werror"
	LDFLAGS="-static -no-pie -nostartfiles -Wl,--build-id=none -Wl,-z,noexecstack"
	objs=""
	for src in $(for d in $ddirs; do echo "$d"*.c; done) "$ldir"*.S "$ldir"*.c; do
		o="$out/$(basename "${src%.*}").o"; $CC $CFLAGS -c -o "$o" "$src"; objs="$objs $o"
	done
	$CC $CFLAGS $LDFLAGS -T "$ldir/loader.ld" -o "$out/loader.elf" $objs
	# each program is built against its own loader's program format, unchanged
	members=""; summary=""
	for prog in $progs; do
		pdir=$(field "$(code_file "$prog")" source)
		[ -d "$pdir" ] || die "source $pdir is not in the pool"
		pl=$(list_field "$(code_file "$prog")" depends | head -1)
		pldir=$(field "$(code_file "$pl")" source)
		pname=$(basename "${prog#PART.}"); pname=${pname%@*}
		$CC $CFLAGS -c -o "$out/$pname.o" "$pdir$pname.c"
		# the referee, after: rule 12, a program touches no hardware.  Its own
		# assembly, from the same compiler: no port I/O, no privileged instruction.
		hw=$($CC $CFLAGS -S -o - "$pdir$pname.c" | grep -E '^[[:space:]]*(in|out|ins|outs)[bwl]?[[:space:]]|^[[:space:]]*(cli|sti|hlt|lgdt|lidt|ltr|wrmsr|rdmsr|invlpg)([[:space:]]|$)|mov[l]?[[:space:]].*%cr[0-9]' | head -1 | sed 's/^[[:space:]]*//' || true)
		[ -z "$hw" ] || die "rule 12: $prog touches the hardware itself ($hw); a program asks the system, through its system calls"
		$CC $CFLAGS $LDFLAGS -T "$pldir/program.ld" -o "$out/$pname.bin" "$out/$pname.o"
		members="$members $pname $out/$pname.bin"; summary="$summary + $prog ($(wc -c < "$out/$pname.bin") bytes)"
	done
	if [ "$(echo $progs | wc -w)" -gt 1 ]; then
		newc "$out/programs.bin" $members
		pname=programs
	fi
	printf 'built flavor %s: %s (%s)%s -> %s/\n' "$1" "$loader" "$(sha256sum < "$out/loader.elf" | cut -c1-16)" "$summary" "$out"
	echo "$pname" > "$out/program"
}

cmd_run() {
	cmd_build "$1"
	f=$(flavor_file "$1"); mdir=$(field "$(code_file "$(field "$f" machine)")" source)
	pname=$(cat "out/$1/program")
	exec sh "$mdir/machine.sh" "out/$1/loader.elf" "out/$1/$pname.bin"
}

# The decision ledger (plan 3.6).  Deterministic: paths and file names, no judgment.
cmd_ledger() {
	if [ "${1:-}" = "--cached" ]; then
		changed=$(git diff --cached --name-only --diff-filter=ACMRD HEAD)
	elif [ "${1:-}" = "--commit" ]; then
		# one commit, as it was made: what it changed, against its parent.  The
		# second lock, run where nobody types (jig/test), so --no-verify on a
		# PC only delays the refusal.
		rev=${2:-HEAD}
		git cat-file -e "$rev:constitution/human-only.toml" 2>/dev/null || { printf 'ledger: %s predates the ledger (no constitution/human-only.toml in it); nothing to hold it to\n' "$(git rev-parse --short "$rev")"; return 0; }
		changed=$(git diff-tree --no-commit-id --name-only -r --diff-filter=ACMRD "$rev")
	else
		changed=$( { git diff --name-only HEAD; git ls-files --others --exclude-standard; } | sort -u)
	fi
	decisions=$(echo "$changed" | grep '^decisions/[0-9]*\.toml$' || true)
	for d in $decisions; do
		[ -f "$d" ] || continue
		by=$(field "$d" by)
		[ -f "constitution/keys/${by#KEY.}.toml" ] || die "ledger: $d is decided by \"$by\", which is not a key in constitution/keys/"
	done
	n=0
	for p in $changed; do
		kind=""
		while IFS= read -r line; do
			k=$(echo "$line" | sed -n 's/^\([a-z][a-z ]*[a-z]\) *= *\[.*/\1/p')
			[ -n "$k" ] || continue
			for g in $(echo "$line" | sed 's/^[^=]*= *\[\(.*\)\].*/\1/' | tr ',' '\n' | sed 's/[" ]//g' | grep .); do
				case "$p" in $g) kind=$k ;; esac
			done
		done < constitution/human-only.toml
		[ -n "$kind" ] || continue
		named=""
		for d in $decisions; do
			[ -f "$d" ] || continue
			for g in $(list_field "$d" touches); do
				case "$p" in $g) named=$d ;; esac
			done
		done
		[ -n "$named" ] || die "ledger: $p changed; $kind are human-only, and no decision in this change names it"
		n=$((n + 1))
	done
	printf 'ledger: %s human-only change(s), each named by a decision, decided by a key in constitution/keys/\n' "$n"
}

# referee: rules 2 to 8 of schema/petition.md, every petition, one line per
# rule per petition.  Reports, never trusts: the file it writes is what a post
# may quote.  Each rule is one block so one mutation can switch one rule off.
pet_rows() {	# petition file -> "kind<TAB>code<TAB>a<TAB>b": capability code reason; component code admitted role; sensor code binds consumer
	awk '
	/^\[\[/ { flush(); k=$0; gsub(/[\[\] ]/,"",k); c=a=b=r="" ; next }
	/^code/     { v=$0; sub(/^[^"]*"/,"",v); sub(/".*/,"",v); c=v }
	/^reason/   { v=$0; sub(/^[^"]*"/,"",v); sub(/".*/,"",v); a=v }
	/^admitted/ { v=$3; gsub(/[" ]/,"",v); a=v }
	/^role/     { v=$0; sub(/^[^"]*"/,"",v); sub(/".*/,"",v); b=v }
	/^binds/    { v=$0; sub(/^[^"]*"/,"",v); sub(/".*/,"",v); a=v }
	/^consumer/ { v=$0; sub(/^[^"]*"/,"",v); sub(/".*/,"",v); b=v }
	END { flush() }
	function flush() { if (k=="capability"||k=="component"||k=="sensor") print k "\t" c "\t" a "\t" b; k="" }' "$1"
}
cmd_rules() {
	log="tests/referee-results.txt"
	commit=$(git rev-parse --short HEAD 2>/dev/null || echo "not a git checkout")
	{ echo "# tests/referee-results.txt, written by jig/aios rules.  Do not edit by hand."
	  echo "# run $(date -u +%Y-%m-%dT%H:%MZ) at commit $commit: rules 2 to 8 of schema/petition.md, every petition"; } > "$log"
	fails=0
	for pet in petitions/*.toml; do
		id=$(field "$pet" id)
		rows=$(pet_rows "$pet")
		caps=$(echo "$rows" | awk -F'\t' '$1=="capability"{print $2}')
		comps=$(echo "$rows" | awk -F'\t' '$1=="component"{print $2}')
		primary=$(echo "$rows" | awk -F'\t' '$1=="component" && $4=="primary"{print $2}')
		# the components and everything they depend on, walked once
		all=$comps; todo=$comps
		while [ -n "$todo" ]; do
			next=""
			for c in $todo; do
				cf=$(code_file "$c"); [ -f "$cf" ] || continue
				for d in $(list_field "$cf" depends); do
					echo "$all" | grep -qx "$d" || { all="$all
$d"; next="$next $d"; }
				done
			done
			todo=$next
		done
		r() { if [ -z "$2" ]; then echo "PASS  rule $1  petition $id"; else echo "FAIL  rule $1  petition $id  $2"; fails=$((fails + 1)); fi >> "$log"; }
		# rule 2: every capability's reason is a SPEC clause of a component in the petition
		bad=""
		for line in $(echo "$rows" | awk -F'\t' '$1=="capability"{print $2 "=" $3}'); do
			cap=${line%%=*}; reason=${line#*=}
			sf=$(code_file "$reason")
			case "$reason" in SPEC.*) ;; *) bad="$cap reason \"$reason\" is not a SPEC"; break ;; esac
			[ -f "$sf" ] || { bad="$cap reason $reason does not exist"; break; }
			echo "$comps" | grep -qx "$(field "$sf" component)" || { bad="$cap reason $reason belongs to $(field "$sf" component), not in the petition"; break; }
		done
		r 2 "$bad"
		# rule 3: every SPEC clause of the primary component is bound by a TST
		bad=""
		for sf in specs/*.toml; do
			[ "$(field "$sf" component)" = "$primary" ] || continue
			sc=$(field "$sf" code)
			grep -lq "^binds *= *\"$sc\"" tests/*.toml || { bad="$sc has no test"; break; }
		done
		r 3 "$bad"
		# rule 4: every CAP a component requires is asked for
		bad=""
		for c in $all; do
			cf=$(code_file "$c"); [ -f "$cf" ] || continue
			for q in $(list_field "$cf" requires); do
				echo "$caps" | grep -qx "$q" || { bad="$c requires $q, not asked for"; break 2; }
			done
		done
		r 4 "$bad"
		# rule 5: every CAP asked for is exposed by a component in the petition
		bad=""
		exposed=$(for c in $all; do cf=$(code_file "$c"); [ -f "$cf" ] && list_field "$cf" exposes; done)
		for q in $caps; do echo "$exposed" | grep -qx "$q" || { bad="$q is granted but nothing in the petition exposes it"; break; }; done
		r 5 "$bad"
		# rule 6: every component's run-time depends are in the petition, transitively
		bad=""
		for c in $all; do echo "$comps" | grep -qx "$c" || { bad="$c is depended on but not listed"; break; }; done
		r 6 "$bad"
		# rule 7: a component marked admitted has an admission in its catalogue entry
		bad=""
		for c in $(echo "$rows" | awk -F'\t' '$1=="component" && $3=="true"{print $2}'); do
			cf=$(code_file "$c")
			[ -n "$(field "$cf" admitted)" ] || { bad="$c is marked admitted and has no admission"; break; }
		done
		r 7 "$bad"
		# rule 8: every sensor names a SPEC clause and a consumer key
		bad=""
		for line in $(echo "$rows" | awk -F'\t' '$1=="sensor"{print $2 "=" $3 "=" $4}'); do
			sn=${line%%=*}; rest=${line#*=}; binds=${rest%%=*}; consumer=${rest#*=}
			case "$binds" in SPEC.*) [ -f "$(code_file "$binds")" ] || { bad="$sn binds $binds, which does not exist"; break; } ;; *) bad="$sn names no SPEC clause"; break ;; esac
			[ -n "$consumer" ] && [ -f "$(code_file "$consumer")" ] || { bad="$sn has no consumer"; break; }
		done
		r 8 "$bad"
	done
	echo "# $fails failure(s)" >> "$log"
	cat "$log"
	[ "$fails" -eq 0 ]
}

# referee: rule 13.  Output from a committee seat or the mechanic is a numbered
# list, one line each, "N. verb NOUN".  The verb is one of constitution/verbs.toml.
# The noun is a catalogue number that resolves.  record and ask may name a verb
# that does not exist yet, as VERB.name, and no line in the same list may use it.
# Prose, an unknown verb, an unknown noun: refused, naming the line.
cmd_lines() {
	f=${1:?file}; [ -f "$f" ] || die "rule 13: no file $f"
	verbs=$(sed -n 's/^\([a-z]*\) *= *".*/\1/p' constitution/verbs.toml)
	n=0; asked=""
	while IFS= read -r line || [ -n "$line" ]; do
		line=$(printf '%s' "$line" | tr -d '\r')
		[ -n "$line" ] || continue
		n=$((n + 1))
		num=${line%%.*}; rest=${line#*. }
		[ "$num" = "$n" ] && [ "$rest" != "$line" ] || die "rule 13: line $n is not numbered $n: \"$line\""
		verb=${rest%% *}; noun=${rest#* }
		[ "$noun" != "$rest" ] && [ -n "$noun" ] || die "rule 13: line $n has no noun: \"$line\""
		case "$noun" in *" "*) die "rule 13: line $n is more than a verb and a noun: \"$line\"" ;; esac
		echo "$verbs" | grep -qx "$verb" || die "rule 13: line $n uses a verb not in constitution/verbs.toml: \"$verb\""
		case "$noun" in
			VERB.*) case "$verb" in record|ask) asked="$asked ${noun#VERB.}" ;; *) die "rule 13: line $n: only record and ask may name a verb that does not exist: \"$line\"" ;; esac ;;
			*) cf=$(code_file "$noun"); [ -n "$cf" ] && [ -f "$cf" ] || die "rule 13: line $n names a noun that is not in the catalogue: \"$noun\"" ;;
		esac
	done < "$f"
	[ "$n" -gt 0 ] || die "rule 13: $f is empty"
	# a verb asked for cannot also be used: a used verb must be in the
	# constitution (checked above), and one that is cannot be asked for
	for a in $asked; do
		echo "$verbs" | grep -qx "$a" && die "rule 13: the verb \"$a\" is asked for and already exists"
	done
	printf 'rule 13: %s line(s), every verb in the constitution, every noun in the catalogue%s\n' "$n" "${asked:+; asked for:$asked}"
}

case "${1:-}" in
	list)  cmd_list ;;
	ledger) cmd_ledger "${2:-}" "${3:-}" ;;
	rules) cmd_rules ;;
	lines) cmd_lines "${2:?file}" ;;
	check) cmd_check "${2:?flavor}" ;;
	build) cmd_build "${2:?flavor}" ;;
	run)   cmd_run "${2:?flavor}" ;;
	pack)  shift; newc "$@" ;;
	*) sed -n '2,14p' "$0"; exit 2 ;;
esac
