#!/bin/sh
# aios: the builder, as a shell script, until it is a real component (plan
# section 5).  The referee is pool/AGT.referee@1/referee, called before and
# after every build (moved out of this script on 2026-10-15).  POSIX sh only;
# reads the repo's TOML with sed, which is enough for the flat files the
# schema allows.
#
#   aios list                 flavors and petitions in this repo
#   aios build <flavor>       builder: collect the components, compile, image
#   aios run <flavor>         check, build, boot on the flavor's machine
#   aios pack <archive> <name> <file>...   programs into one cpio archive, in
#                             order, the way build does for a flavor of several
#
# Failures name codes, never tool output.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo"

die() { printf 'refused: %s\n' "$*" >&2; exit 1; }
field() { sed -n "s/^$2 *= *\"\([^\"]*\)\".*/\1/p" "$1" | head -1; }
list_field() { sed -n "s/^$2 *= *\[\(.*\)\].*/\1/p" "$1" | tr ',' '\n' | sed 's/[" ]//g' | grep . || true; }

# code -> file.  PART.loader@1 -> index/part/loader@1.toml
code_file() {
	t=${1%%.*}; rest=${1#*.}
	case "$rest" in *@*) ;; *) rest="$rest@1" ;; esac
	case "$t" in
		PUR)  echo "constitution/purposes/$rest.toml" ;;
		KEY)  echo "constitution/keys/$rest.toml" ;;
		CAP)  echo "index/cap/$rest.toml" ;;
		PART) echo "index/part/$rest.toml" ;;
		MACHINE) echo "index/machine/$rest.toml" ;;
		TOOL) echo "index/tool/$rest.toml" ;;
		SPEC) echo "specs/$rest.toml" ;;
		TST)  echo "tests/$rest.toml" ;;
		SNS)  echo "sensors/$rest.toml" ;;
		AGT)  echo "index/agent/$rest.toml" ;;
		FND)  echo "findings/${rest%@*}.md" ;;
		*)    echo "" ;;
	esac
}

# every code mentioned anywhere in a petition file
petition_codes() {
	sed -n 's/.*"\(\(PUR\|KEY\|CAP\|PART\|MACHINE\|TOOL\|AGT\|SPEC\|TST\|SNS\|FND\)\.[a-z0-9.-]*\(@[0-9]*\)\?\)".*/\1/p' "$1" | sort -u
}

petition_primary() {
	awk '/^\[\[component\]\]/{c="";r=""} /^code/{gsub(/[" ]/,"",$3);c=$3} /^role/{gsub(/[" ]/,"",$3);r=$3; if(r=="primary")print c}' "$1"
}

flavor_file() { f="flavors/$1.toml"; [ -f "$f" ] || die "no flavor named $1"; echo "$f"; }

cmd_list() {
	echo "flavors:";   for f in flavors/*.toml; do printf '  %-8s petitions %s\n' "$(field "$f" name)" "$(list_field "$f" petitions | tr '\n' ' ')"; done
	echo "petitions:"; for p in petitions/*.toml; do printf '  %s  %s  %s\n' "$(field "$p" id)" "$(field "$p" status)" "$(field "$(code_file "$(field "$p" purpose)")" sentence)"; done
}

# the loader for a set of programs: the newest one any of them depends on
loader_for() {
	for p in "$@"; do list_field "$(code_file "$p")" depends; done | sort -t@ -k2,2n | tail -1
}

# newc ARCHIVE NAME FILE...: a cpio archive in the "new ASCII" format (magic 070701),
# the one Linux's initramfs uses, one regular file per program, in order.
newc() {
	arc=$1; shift; : > "$arc"; ino=1
	pad() { n=$(( (4 - $(wc -c < "$arc") % 4) % 4 )); [ $n -eq 0 ] || head -c $n /dev/zero >> "$arc"; }
	hdr() {	# name size mode
		printf '070701%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X' \
			$ino $3 0 0 1 0 $2 0 0 0 0 $(( ${#1} + 1 )) 0 >> "$arc"
		printf '%s\0' "$1" >> "$arc"; pad; ino=$((ino + 1))
	}
	while [ $# -gt 0 ]; do
		hdr "$1" "$(wc -c < "$2")" $((0100644)); cat "$2" >> "$arc"; pad; shift 2
	done
	hdr TRAILER!!! 0 0
}

cmd_build() {
	sh pool/AGT.referee@1/referee check "$1" >/dev/null
	f=$(flavor_file "$1")
	progs=$(for id in $(list_field "$f" petitions); do petition_primary "petitions/$id.toml"; done)
	# walk run-time depends from the programs down; the loader is the newest any of them depends on
	for prog in $progs; do [ -n "$(list_field "$(code_file "$prog")" depends)" ] || die "rule 17: $prog depends on nothing; a program needs a loader"; done
	loader=$(loader_for $progs)
	ldir=$(field "$(code_file "$loader")" source)
	ddirs=""	# everything the loader depends on (lifted parts), built into it
	for dep in $(list_field "$(code_file "$loader")" depends); do
		ddirs="$ddirs $(field "$(code_file "$dep")" source)"
	done
	for d in "$ldir" $ddirs; do [ -d "$d" ] || die "rule 18: source $d is not in the pool"; done
	out="out/$1"; mkdir -p "$out"
	CC=${CC:-gcc}
	CFLAGS="-m32 -std=c11 -ffreestanding -fno-pic -fno-pie -fno-stack-protector -fno-builtin -fno-asynchronous-unwind-tables -mno-sse -mno-mmx -mno-red-zone -mgeneral-regs-only -nostdlib -nostdinc -O2 -Wall -Wextra -Werror"
	LDFLAGS="-static -no-pie -nostartfiles -Wl,--build-id=none -Wl,-z,noexecstack"
	objs=""
	for src in $(for d in $ddirs; do echo "$d"*.c; done) "$ldir"*.S "$ldir"*.c; do
		o="$out/$(basename "${src%.*}").o"; $CC $CFLAGS -c -o "$o" "$src"; objs="$objs $o"
	done
	$CC $CFLAGS $LDFLAGS -T "$ldir/loader.ld" -o "$out/loader.elf" $objs
	# each program is built against its own loader's program format, unchanged
	members=""; summary=""
	for prog in $progs; do
		pdir=$(field "$(code_file "$prog")" source)
		[ -d "$pdir" ] || die "rule 18: source $pdir is not in the pool"
		pl=$(list_field "$(code_file "$prog")" depends | head -1)
		pldir=$(field "$(code_file "$pl")" source)
		pname=$(basename "${prog#PART.}"); pname=${pname%@*}
		$CC $CFLAGS -c -o "$out/$pname.o" "$pdir$pname.c"
		# the referee, after: rule 12, a program touches no hardware
		CC="$CC" CFLAGS="$CFLAGS" sh pool/AGT.referee@1/referee hardware "$prog" "$pdir$pname.c"
		$CC $CFLAGS $LDFLAGS -T "$pldir/program.ld" -o "$out/$pname.bin" "$out/$pname.o"
		members="$members $pname $out/$pname.bin"; summary="$summary + $prog ($(wc -c < "$out/$pname.bin") bytes)"
	done
	if [ "$(echo $progs | wc -w)" -gt 1 ]; then
		newc "$out/programs.bin" $members
		pname=programs
	fi
	printf 'built flavor %s: %s (%s)%s -> %s/\n' "$1" "$loader" "$(sha256sum < "$out/loader.elf" | cut -c1-16)" "$summary" "$out"
	echo "$pname" > "$out/program"
}

cmd_run() {
	cmd_build "$1"
	f=$(flavor_file "$1"); mdir=$(field "$(code_file "$(field "$f" machine)")" source)
	pname=$(cat "out/$1/program")
	exec sh "$mdir/machine.sh" "out/$1/loader.elf" "out/$1/$pname.bin"
}

case "${1:-}" in
	list)  cmd_list ;;
	check|rules|lines|ledger) exec sh pool/AGT.referee@1/referee "$@" ;;	# the referee, for old habits
	build) cmd_build "${2:?flavor}" ;;
	run)   cmd_run "${2:?flavor}" ;;
	pack)  shift; newc "$@" ;;
	*) sed -n '2,15p' "$0"; exit 2 ;;
esac
