#!/bin/sh
# aios: the builder, as a shell script, until it is a real component (plan
# section 5).  The referee is pool/AGT.referee@1/referee, called before and
# after every build (moved out of this script on 2026-10-15).  POSIX sh only;
# reads the repo's TOML with sed, which is enough for the flat files the
# schema allows.
#
#   aios list                 flavors and petitions in this repo
#   aios build <flavor>       builder: collect the components, compile, image;
#                             if the petitions name catalogue numbers that have no
#                             entry, stop (exit 3) and write them to out/<flavor>/missing.txt
#   aios missing <flavor>     those catalogue numbers, one to a line, and nothing else
#   aios run <flavor>         check, build, boot on the flavor's machine
#   aios pack <archive> <name> <file>...   programs into one cpio archive, in
#                             order, the way build does for a flavor of several
#
# Failures name codes, never tool output.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo"

die() { printf 'refused: %s\n' "$*" >&2; exit 1; }
field() { sed -n "s/^$2 *= *\"\([^\"]*\)\".*/\1/p" "$1" | head -1; }
list_field() { sed -n "s/^$2 *= *\[\(.*\)\].*/\1/p" "$1" | tr ',' '\n' | sed 's/[" ]//g' | grep . || true; }

# code -> file.  PART.loader@1 -> index/part/loader@1.toml
code_file() {
	t=${1%%.*}; rest=${1#*.}
	case "$rest" in *@*) ;; *) rest="$rest@1" ;; esac
	case "$t" in
		PUR)  echo "constitution/purposes/$rest.toml" ;;
		KEY)  echo "constitution/keys/$rest.toml" ;;
		CAP)  echo "index/cap/$rest.toml" ;;
		PART) echo "index/part/$rest.toml" ;;
		MACHINE) echo "index/machine/$rest.toml" ;;
		TOOL) echo "index/tool/$rest.toml" ;;
		SPEC) echo "specs/$rest.toml" ;;
		TST)  echo "tests/$rest.toml" ;;
		SNS)  echo "sensors/$rest.toml" ;;
		AGT)  echo "index/agent/$rest.toml" ;;
		FND)  echo "findings/${rest%@*}.md" ;;
		*)    echo "" ;;
	esac
}

# every code mentioned anywhere in a petition file
petition_codes() {
	sed -n 's/.*"\(\(PUR\|KEY\|CAP\|PART\|MACHINE\|TOOL\|AGT\|SPEC\|TST\|SNS\|FND\)\.[a-z0-9.-]*\(@[0-9]*\)\?\)".*/\1/p' "$1" | sort -u
}

petition_primary() {
	awk '/^\[\[component\]\]/{c="";r=""} /^code/{gsub(/[" ]/,"",$3);c=$3} /^role/{gsub(/[" ]/,"",$3);r=$3; if(r=="primary")print c}' "$1"
}

flavor_file() { f="flavors/$1.toml"; [ -f "$f" ] || die "no flavor named $1"; echo "$f"; }

cmd_list() {
	echo "flavors:";   for f in flavors/*.toml; do printf '  %-8s petitions %s\n' "$(field "$f" name)" "$(list_field "$f" petitions | tr '\n' ' ')"; done
	echo "petitions:"; for p in petitions/*.toml; do printf '  %s  %s  %s\n' "$(field "$p" id)" "$(field "$p" status)" "$(field "$(code_file "$(field "$p" purpose)")" sentence)"; done
}

# the kernel for a flavor: the newest boot component its petitions name (rule 19's
# kernel too).  A petition with no boot component falls back to the newest kernel
# its programs depend on, the way it was chosen before plan 5.8.
petition_boot() {
	awk '/^\[\[component\]\]/{c="";r=""} /^code/{gsub(/[" ]/,"",$3);c=$3} /^role/{gsub(/[" ]/,"",$3);r=$3; if(r=="boot")print c}' "$1"
}
petition_parts() {	# every PART a petition names as a dependency
	awk '/^\[\[component\]\]/{c="";r=""} /^code/{gsub(/[" ]/,"",$3);c=$3} /^role/{gsub(/[" ]/,"",$3);r=$3; if(r=="dependency")print c}' "$1"
}
loader_for() {
	for p in "$@"; do list_field "$(code_file "$p")" depends; done | sort -t@ -k2,2n | tail -1
}
kernel_for() {	# FLAVOR_FILE PROGRAMS...
	ff=$1; shift
	k=$(for id in $(list_field "$ff" petitions); do petition_boot "petitions/$id.toml"; done | sort -t@ -k2,2n | tail -1)
	[ -n "$k" ] && echo "$k" || loader_for "$@"
}
# PART.timer.tsc-pit@2 -> HAVE_TIMER_TSC_PIT
have_of() { n=${1#PART.}; n=${n%@*}; echo "HAVE_$(echo "$n" | tr 'a-z.-' 'A-Z__')"; }

# newc ARCHIVE NAME FILE...: a cpio archive in the "new ASCII" format (magic 070701),
# the one Linux's initramfs uses, one regular file per program, in order.
newc() {
	arc=$1; shift; : > "$arc"; ino=1
	pad() { n=$(( (4 - $(wc -c < "$arc") % 4) % 4 )); [ $n -eq 0 ] || head -c $n /dev/zero >> "$arc"; }
	hdr() {	# name size mode
		printf '070701%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X%08X' \
			$ino $3 0 0 1 0 $2 0 0 0 0 $(( ${#1} + 1 )) 0 >> "$arc"
		printf '%s\0' "$1" >> "$arc"; pad; ino=$((ino + 1))
	}
	while [ $# -gt 0 ]; do
		hdr "$1" "$(wc -c < "$2")" $((0100644)); cat "$2" >> "$arc"; pad; shift 2
	done
	hdr TRAILER!!! 0 0
}

# every catalogue number the flavor's petitions name that has no catalogue entry, one to
# a line with what kind of thing it is; sorted, so the same flavor gives the same list
cmd_missing() {
	f=$(flavor_file "$1")
	for id in $(list_field "$f" petitions); do petition_codes "petitions/$id.toml"; done | LC_ALL=C sort -u | while read -r c; do
		[ -e "$(code_file "$c")" ] && continue
		case "${c%%.*}" in
			PUR) k=purpose ;; KEY) k=key ;; CAP) k=capability ;; PART) k=part ;; MACHINE) k=machine ;;
			TOOL) k=tool ;; AGT) k=agent ;; SPEC) k=clause ;; TST) k=test ;; SNS) k=sensor ;; FND) k=finding ;;
			*) k=thing ;;
		esac
		printf '%s  %s not in the catalogue\n' "$c" "$k"
	done
}

# prog_flags CODE: the extra compile flags a program's catalogue entry lists in
# cflags (SPEC.builder.3@1), one to a line, -include=H as -include and H; any
# flag outside the allowed forms stops the build, naming the program and the flag
prog_flags() {
	for x in $(list_field "$(code_file "$1")" cflags); do
		if printf '%s' "$x" | grep -Eqx -- '-std=[a-z0-9]+|-D[A-Za-z_][A-Za-z0-9_]*(\([A-Za-z_]+\))?(=[A-Za-z0-9_]*)?'; then
			printf '%s\n' "$x"
		elif printf '%s' "$x" | grep -Eqx -- '-include=[A-Za-z0-9_][A-Za-z0-9_/.@-]*\.h' && ! printf '%s' "$x" | grep -q '\.\.'; then
			printf -- '-include\n%s\n' "${x#-include=}"
		else
			die "SPEC.builder.3: $1 lists the compile flag '$x', which is not -std=, -D or -include= of a header"
		fi
	done
}

# libc_musl DIR: musl from lifted/PART.libc.musl@1, built the way jig/libc builds
# the pinned one: the two generated headers from their lifted inputs, every
# lifted source compiled with musl's own flags for i386, the library, the start
# files, the headers a program sees, and the divide helper musl needs
# (PART.divide64@1).  Only what was lifted is there to build.
libc_musl() {
	m=lifted/PART.libc.musl@1; d=$1
	[ -f "$d/libc.a" ] && return 0
	mkdir -p "$d/obj/include/bits" "$d/include/bits"
	sed -f "$m/tools/mkalltypes.sed" "$m/arch/i386/bits/alltypes.h.in" "$m/include/alltypes.h.in" > "$d/obj/include/bits/alltypes.h"
	cp "$m/arch/i386/bits/syscall.h.in" "$d/obj/include/bits/syscall.h"
	sed -n -e s/__NR_/SYS_/p < "$m/arch/i386/bits/syscall.h.in" >> "$d/obj/include/bits/syscall.h"
	mf="-m32 -std=c99 -nostdinc -ffreestanding -fexcess-precision=standard -frounding-math -fno-strict-aliasing -Wa,--noexecstack -D_XOPEN_SOURCE=700 -I$m/arch/i386 -I$m/arch/generic -I$d/obj/src/internal -I$m/src/include -I$m/src/internal -I$d/obj/include -I$m/include -Os -fomit-frame-pointer -fno-unwind-tables -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections -march=i486 -mtune=generic -fno-pie -w"
	( cd "$m" && find src -type f \( -name '*.c' -o -name '*.s' \) ) | LC_ALL=C sort | while read -r f; do
		o="$d/obj/$(echo "$f" | tr / @).o"
		x=""; case "$f" in */__libc_start_main.c|*/__init_tls.c|*/__set_thread_area.s|*/memset.s|*/memcpy.s) x="-fno-stack-protector" ;; esac
		$CC $mf $x -c -o "$o" "$m/$f" || exit 1
	done || die "musl from lifted/ did not compile"
	( cd "$d/obj" && ls *.o | LC_ALL=C sort | xargs ar rcs ../libc.a )
	$CC $mf -DCRT -fno-stack-protector -c -o "$d/crt1.o" "$m/crt/crt1.c"
	$CC $mf -c -o "$d/crti.o" "$m/crt/i386/crti.s"
	$CC $mf -c -o "$d/crtn.o" "$m/crt/i386/crtn.s"
	$CC -m32 -O2 -ffreestanding -fno-pie -c -o "$d/divide64.o" pool/PART.divide64@1/divide64.c
	( cd "$m/include" && find . -type f ! -name '*.in' ) | while read -r h; do mkdir -p "$d/include/$(dirname "$h")"; cp "$m/include/$h" "$d/include/$h"; done
	cp "$m"/arch/generic/bits/*.h "$d/include/bits/"; cp "$m"/arch/i386/bits/*.h "$d/include/bits/"
	cp "$d/obj/include/bits/alltypes.h" "$d/obj/include/bits/syscall.h" "$d/include/bits/"
}

cmd_build() {
	miss=$(cmd_missing "$1")
	if [ -n "$miss" ]; then
		mkdir -p "out/$1"; printf '%s\n' "$miss" > "out/$1/missing.txt"
		printf 'stopped: %s catalogue numbers are missing; the list is out/%s/missing.txt\n' "$(printf '%s\n' "$miss" | wc -l | tr -d ' ')" "$1" >&2
		exit 3
	fi
	rm -f "out/$1/missing.txt" 2> /dev/null || :
	# every program's own flags are checked before anything is compiled
	for id in $(list_field "$(flavor_file "$1")" petitions); do p=$(petition_primary "petitions/$id.toml"); prog_flags "$p" > /dev/null || exit 1; done
	sh pool/AGT.referee@1/referee check "$1" >/dev/null
	f=$(flavor_file "$1")
	progs=$(for id in $(list_field "$f" petitions); do petition_primary "petitions/$id.toml"; done)
	# walk run-time depends from the programs down; the loader is the newest any of them depends on
	for prog in $progs; do [ -n "$(list_field "$(code_file "$prog")" depends)" ] || die "rule 17: $prog depends on nothing; a program needs a loader"; done
	loader=$(kernel_for "$f" $progs)
	lf=$(code_file "$loader"); ldir=$(field "$lf" source)
	out="out/$1"; mkdir -p "$out"
	CC=${CC:-gcc}
	CFLAGS="-m32 -std=c11 -ffreestanding -fno-pic -fno-pie -fno-stack-protector -fno-builtin -fno-asynchronous-unwind-tables -mno-sse -mno-mmx -mno-red-zone -mgeneral-regs-only -nostdlib -nostdinc -O2 -Wall -Wextra -Werror"
	LDFLAGS="-static -no-pie -nostartfiles -Wl,--build-id=none -Wl,-z,noexecstack"
	if [ -n "$(list_field "$lf" builds_with)" ]; then
		# plan 5.8, the petition is the partition: the kernel's own depends, plus
		# every part the flavor's petitions name that it builds with, plus what
		# those depend on, one version of each (the newest named), and nothing else
		want=$( { list_field "$lf" depends
			for id in $(list_field "$f" petitions); do petition_parts "petitions/$id.toml"; done | while read -r c; do
				list_field "$lf" builds_with | grep -qx "$c" && echo "$c"; done; } | sort -u)
		while :; do
			more=$(for c in $want; do list_field "$(code_file "$c")" depends; done | sort -u)
			next=$(printf '%s\n' $want $more | grep . | sort -u)
			[ "$next" = "$want" ] && break; want=$next
		done
		parts=""; for n in $(for c in $want; do echo "${c%@*}"; done | sort -u); do
			parts="$parts $(for c in $want; do case $c in "$n"@*) echo "$c" ;; esac; done | sort -t@ -k2,2n | tail -1)"
		done
		ddirs=""; incs="-I $ldir"; haves=""
		for c in $parts; do d=$(field "$(code_file "$c")" source); ddirs="$ddirs $d"; incs="$incs -I $d"; haves="$haves -D$(have_of "$c")"; done
		echo "$parts" | tr ' ' '\n' | grep . > "$out/kernel-parts.txt"
	else
		ddirs=""; incs=""; haves=""	# before @8: everything the loader depends on, built into it
		for dep in $(list_field "$lf" depends); do ddirs="$ddirs $(field "$(code_file "$dep")" source)"; done
		rm -f "$out/kernel-parts.txt"
	fi
	for d in "$ldir" $ddirs; do [ -d "$d" ] || die "rule 18: source $d is not in the pool"; done
	objs=""
	# the parts, then the kernel's own .S then .c: the link order every earlier kernel was built in
	for src in $(for d in $ddirs; do for x in "$d"*.c "$d"*.S; do [ -e "$x" ] && echo "$x"; done; done) $(for x in "$ldir"*.S "$ldir"*.c; do [ -e "$x" ] && echo "$x"; done); do
		o="$out/$(basename "${src%.*}").o"; $CC $CFLAGS $haves $incs -c -o "$o" "$src"; objs="$objs $o"
	done
	$CC $CFLAGS $LDFLAGS -T "$ldir/loader.ld" -o "$out/loader.elf" $objs
	# each program is built against its own loader's program format, unchanged
	members=""; summary=""
	for prog in $progs; do
		pdir=$(field "$(code_file "$prog")" source)
		[ -d "$pdir" ] || die "rule 18: source $pdir is not in the pool"
		if list_field "$(code_file "$prog")" depends | grep -qx 'PART.libc.musl@1'; then
			# a normal Linux program: built against musl from lifted/, linked the
			# way a Linux toolchain links a static program, an ELF file (part 20)
			pname=$(basename "${prog#PART.}"); pname=${pname%@*}
			libc_musl "$out/musl"
			pf=$(prog_flags "$prog" | tr '\n' ' '); pq=$(prog_flags "$prog" | sed "s/.*/'&'/" | tr '\n' ' ')
			mflags="-m32 -O2 -nostdinc -fno-pie -fno-stack-protector -I $out/musl/include"
			$CC $mflags $pf -c -o "$out/$pname.o" "$pdir$pname.c"
			CC="$CC" CFLAGS="$mflags $pq" sh pool/AGT.referee@1/referee hardware "$prog" "$pdir$pname.c"
			$CC -m32 -static -nostdlib -no-pie -Wl,--build-id=none -Wl,-z,noexecstack -o "$out/$pname.bin" \
				"$out/musl/crt1.o" "$out/musl/crti.o" "$out/$pname.o" "$out/musl/libc.a" "$out/musl/divide64.o" "$out/musl/crtn.o"
			members="$members $pname $out/$pname.bin"; summary="$summary + $prog (ELF, $(wc -c < "$out/$pname.bin") bytes)"
			continue
		fi
		pl=$(list_field "$(code_file "$prog")" depends | head -1)
		pldir=$(field "$(code_file "$pl")" source)
		pname=$(basename "${prog#PART.}"); pname=${pname%@*}
		pf=$(prog_flags "$prog" | tr '\n' ' ')
		# the referee hands CFLAGS to a shell, so there each flag goes in quotes (none can hold one)
		pq=$(prog_flags "$prog" | sed "s/.*/'&'/" | tr '\n' ' ')
		$CC $CFLAGS $pf -c -o "$out/$pname.o" "$pdir$pname.c"
		# the referee, after: rule 12, a program touches no hardware
		CC="$CC" CFLAGS="$CFLAGS $pq" sh pool/AGT.referee@1/referee hardware "$prog" "$pdir$pname.c"
		$CC $CFLAGS $LDFLAGS -T "$pldir/program.ld" -o "$out/$pname.bin" "$out/$pname.o"
		members="$members $pname $out/$pname.bin"; summary="$summary + $prog ($(wc -c < "$out/$pname.bin") bytes)"
	done
	if [ "$(echo $progs | wc -w)" -gt 1 ]; then
		newc "$out/programs.bin" $members
		pname=programs
	fi
	printf 'built flavor %s: %s (%s)%s -> %s/\n' "$1" "$loader" "$(sha256sum < "$out/loader.elf" | cut -c1-16)" "$summary" "$out"
	echo "$pname" > "$out/program"
}

cmd_run() {
	cmd_build "$1"
	f=$(flavor_file "$1"); mdir=$(field "$(code_file "$(field "$f" machine)")" source)
	pname=$(cat "out/$1/program")
	exec sh "$mdir/machine.sh" "out/$1/loader.elf" "out/$1/$pname.bin"
}

case "${1:-}" in
	list)  cmd_list ;;
	check|rules|lines|ledger) exec sh pool/AGT.referee@1/referee "$@" ;;	# the referee, for old habits
	missing) cmd_missing "${2:?flavor}" ;;
	build) cmd_build "${2:?flavor}" ;;
	run)   cmd_run "${2:?flavor}" ;;
	pack)  shift; newc "$@" ;;
	*) sed -n '2,15p' "$0"; exit 2 ;;
esac
