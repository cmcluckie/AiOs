#!/bin/sh
# postcheck: every post in posts/ against the rules in CLAUDE.md, "The series".
# Prints one line per failure, naming the file and the rule, and exits 1 if any.
# Silence and exit 0 means every post is consistent.
set -u
repo=$(cd "$(dirname "$0")/.." && pwd); cd "$repo/posts"
R="https://github.com/cmcluckie/aios"
rc=0
bad() { echo "$1: $2"; rc=1; }
has() { grep -qF -- "$2" "$1"; }

# section NAME FILE: the lines strictly inside <section id="NAME"> ... </section>
section() { awk -v id="$1" '$0 ~ "<section id=\""id"\">" {on=1; next} on && /<\/section>/ {on=0} on' "$2"; }

check_html() {
	h=$1; d=${h%.html}
	[ -f "$d.png" ] || bad "$h" "no image $d.png"
	for id in post title article; do
		grep -q "<section id=\"$id\">" "$h" || bad "$h" "missing section '$id'"
	done
	p=$(mktemp); a=$(mktemp)
	section post "$h" | sed '1,/<div id="post-body"/d; /^<\/div>$/,$d' > "$p"
	section article "$h" > "$a"

	first=$(head -1 "$p")
	case "$first" in
		"AiOS, part $n (Kernel code: "[0-9]*" lines). \""*"\"...") ;;
		*) bad "$h" "post's first line is not 'AiOS, part $n (Kernel code: K lines). \"<pull quote>\"...'" ;;
	esac
	[ "$(grep -c . "$p")" -eq 1 ] || bad "$h" "post is more than its one line"
	grep -q '\.  ' "$p" && bad "$h" "post has two spaces after a period; LinkedIn collapses them"

	section title "$h" | grep -q '<h1>[^<][^<]*</h1>' || bad "$h" "title section has no <h1>title</h1>"

	has "$a" "<em>The story behind AiOS, part $n.</em>" || bad "$h" "article does not open with 'The story behind AiOS, part $n.'"
	grep -q '<h1' "$a" && bad "$h" "article uses <h1>; LinkedIn has two heading sizes, use <h2> and <h3>"
	l() { grep -n "<h2>$1</h2>" "$a" | head -1 | cut -d: -f1; }
	ra=$(l "Read along"); tt=$(l "Try this"); ab=$(l "As built"); ad=$(l "Addendum: the tests")
	[ -n "$ra" ] || bad "$h" "article is missing 'Read along'"
	[ -n "$tt" ] || bad "$h" "article is missing 'Try this'"
	[ -n "$ab" ] || bad "$h" "article is missing 'As built'"
	[ -n "$ad" ] || bad "$h" "article is missing 'Addendum: the tests'"
	cg=$(l "Code on GitHub")
	[ -n "$cg" ] || bad "$h" "article is missing 'Code on GitHub'"
	if [ -n "$ra" ] && [ -n "$tt" ] && [ -n "$ab" ] && [ -n "$ad" ] && [ -n "$cg" ]; then
		[ "$ra" -lt "$tt" ] && [ "$tt" -lt "$ab" ] && [ "$ab" -lt "$ad" ] && [ "$ad" -lt "$cg" ] \
			|| bad "$h" "article sections out of order (Read along, Try this, As built, Addendum, Code on GitHub)"
	fi
	g=$(mktemp); sed -n '/<h2>Code on GitHub<\/h2>/,$p' "$a" > "$g"
	if ! grep -q "href=\"$R/compare/[0-9a-f]*\.\.\.[0-9a-f]*\">Every line that changed, on one page</a>" "$g" && \
	   ! grep -q "href=\"$R/tree/[0-9a-f]*\">The repo exactly as it stood when" "$g" && \
	   ! grep -q "Every line that changed, on one page (hash when committed)" "$g"; then
		bad "$h" "Code on GitHub is missing the one-page compare link"
	fi
	has "$g" "The commits behind this post, in order:" || bad "$h" "Code on GitHub is missing the commit list"
	grep -q "href=\"$R/commit/[0-9a-f]*\">" "$g" || grep -q "(hash when committed)" "$g" || bad "$h" "Code on GitHub lists no commits"
	has "$g" "<a href=\"$R\">The whole repo</a>" || bad "$h" "Code on GitHub is missing the whole-repo link"
	rm -f "$g"
	sed -n "/<h2>Read along<\/h2>/,/<h2>Try this<\/h2>/p" "$a" | grep -q '<ol>' || bad "$h" "Read along has no numbered list"
	grep -q 'no as-built spec yet' "$a" && bad "$h" "a component has no as-built spec"
	for t in $(grep -o 'tests/[a-z0-9.@-]*\.toml' "$a" | sort -u); do
		[ -f "../$t" ] || bad "$h" "addendum links $t, which does not exist"
	done
	for x in $(grep -o 'index/cmp/[a-z0-9.@-]*\.as-built\.md' "$a" | sort -u); do
		[ -f "../$x" ] || bad "$h" "as-built link $x does not exist"
	done

	grep -q 'lnkd\.in' "$h" && bad "$h" "contains an lnkd.in link; use the GitHub URL"
	grep -q '—' "$h" && bad "$h" "contains an em-dash"
	grep -qiE '\b(thrilled to|excited to share|game.?changer|let that sink in|delve|fast-paced world)\b' "$h" && bad "$h" "corporate phrasing (voice.md, Not him)"
	rm -f "$p" "$a"
}

# Posts in date order, one .html each.
n=0
for d in $(ls 20[0-9][0-9]-[0-9][0-9]-[0-9][0-9].md 20[0-9][0-9]-[0-9][0-9]-[0-9][0-9].html 2>/dev/null | sed 's/\.[a-z]*$//' | sort -u); do
	n=$((n + 1))
	[ -f "$d.md" ] && bad "$d.md" "old format; posts are one .html file now"
	[ -f "$d.story.md" ] && ! head -1 "$d.story.md" | grep -q "kept so links to it still work" && bad "$d.story.md" "old format; the article lives in $d.html"
	[ -f "$d.html" ] && check_html "$d.html"
done
[ "$n" -gt 0 ] || bad posts "no posts found"
exit $rc
