#!/bin/sh
# donecheck: every component in the catalogue against the definition of done in
# CLAUDE.md.  One line per failure naming the component and the rule; exit 1 if
# any.  Scaffold components (provided by the jig for now) are skipped.
# Rule 5, "every test has been run", reads tests/results.txt, which jig/test
# writes: a test with a runner must be there as PASS.  A test with no runner yet
# is reported as a count, not a failure.
set -u
repo=$(cd "$(dirname "$0")/.." && pwd); cd "$repo"
rc=0; never=0
results=tests/results.txt
bad() { echo "$1: $2"; rc=1; }
val() { sed -n "s/^$2 *= *\"\([^\"]*\)\".*/\1/p" "$1" | head -1; }

for e in index/part/*.toml index/machine/*.toml index/tool/*.toml; do
	code=$(val "$e" code)
	grep -q '^scaffold *= *true' "$e" && continue
	src=$(val "$e" source)
	[ -n "$src" ] && [ -d "$src" ] || bad "$code" "rule 1: source directory '$src' missing"
	ab=$(val "$e" as_built)
	[ -n "$ab" ] && [ -f "$ab" ] || bad "$code" "rule 2: no as-built spec ($ab)"
	specs=$(grep -l "^component *= *\"$code\"" specs/*.toml 2>/dev/null)
	[ -n "$specs" ] || bad "$code" "rule 3: no spec clause"
	for sp in $specs; do
		sc=$(val "$sp" code)
		tests=$(grep -l "^binds *= *\"$sc\"" tests/*.toml 2>/dev/null)
		[ -n "$tests" ] || bad "$code" "rule 4: $sc has no test"
		for t in $tests; do
			[ -n "$(val "$t" retired_by)" ] && continue	# retired: its successor carries the rule
			grep -q '^red_when *= *"..*"' "$t" || bad "$code" "rule 4: $(val "$t" code) has no red_when"
			grep -q '^timeout_ms *= *[1-9]' "$t" || bad "$code" "rule 4: $(val "$t" code) has no time limit"
			tc=$(val "$t" code)
			if [ -z "$(val "$t" runner)" ]; then never=$((never + 1))
			elif ! grep -q "^PASS  $tc " "$results" 2>/dev/null; then
				bad "$code" "rule 5: $tc has a runner but no PASS in $results ($(grep "  $tc " "$results" 2>/dev/null | cut -c1-4 || true))"
			fi
		done
	done
	case "$src" in lifted/*)
		[ -f "${src%/}/origin.toml" ] || bad "$code" "rule 6: lifted with no origin record" ;;
	esac
	case "$src" in pool/*)
		grep -q 'SPDX-License-Identifier: GPL-2.0-only' "$src"* 2>/dev/null || bad "$code" "licence: no GPL-2.0-only SPDX header in $src" ;;
	esac
done
[ "$never" -eq 0 ] || echo "rule 5: $never test(s) with no runner yet"
[ -f "$results" ] && sed -n '2s/^# /tests: /p' "$results"
exit $rc
