#!/bin/sh
# upstream: the historian's placeholder.  Reads every lifted/*/origin.toml and asks
# the upstream repository two questions.  Never changes anything; reports.
#
#   upstream verify [part]   does the record match upstream?  For every lifted
#                            range: the blob id at the recorded commit equals the
#                            recorded one.  Red means the record is wrong, not
#                            that upstream moved.
#   upstream watch  [part]   has upstream touched any lifted line since the
#                            recorded commit?  One line per upstream commit per
#                            range.  Silence means nothing moved.
#
# Each origin names its upstream, and each upstream is read from its own clone:
# linux from LINUX (default ../linux), musl from MUSL (default ../musl),
# unix-history (V7 and Berkeley) from BSD or V7 (default ../unix-history-repo).
# A part whose clone is not here is reported as not checked, exit 2 unless
# something was WRONG.  Where a file was lifted whole and untouched (into = ".",
# every file at its own path; or one file whose one range is all of it), verify
# also checks the file in lifted/ is that blob, byte for byte; where such a one
# file was then changed, its [cut] names the changed file's blob (local_blob), and
# verify checks the file is that one instead.
# A re-lift, if one is warranted, is a new version of the part through the door.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd); cd "$repo"

clone_for() {	# $1 upstream name -> its clone, or nothing
	case "$1" in
	linux) d=${LINUX:-$repo/../linux} ;;
	musl) d=${MUSL:-$repo/../musl} ;;
	unix-history) d=${BSD:-${V7:-$repo/../unix-history-repo}} ;;
	*) d="" ;;
	esac
	[ -n "$d" ] && [ -d "$d/.git" ] && echo "$d" || :
}

each_range() {  # $1 origin.toml; emits: file blob start end
	awk -F'=' '
	/^\[\[lift.from\]\]/ {f="";b=""}
	/^file/  {gsub(/[" ]/,"",$2); f=$2}
	/^blob/  {gsub(/[" ]/,"",$2); b=$2}
	/^lines/ {s=$2; gsub(/[\[\] ]/,"",s); n=split(s,a,","); for(i=1;i<n;i+=2) print f, b, a[i], a[i+1]}
	' "$1"
}
commit_of() { sed -n 's/^commit *= *"\([0-9a-f]*\)".*/\1/p' "$1"; }
name_of()   { sed -n 's/^name *= *"\([^"]*\)".*/\1/p' "$1" | head -1; }
into_of()   { sed -n 's/^into *= *"\([^"]*\)".*/\1/p' "$1" | head -1; }
local_of()  { sed -n 's/^local_blob *= *"\([0-9a-f]*\)".*/\1/p' "$1" | head -1; }

CMD=${1:-watch}; shift 2>/dev/null || true
rc=0; unchecked=0
for o in lifted/${1:-*}/origin.toml; do
	part=$(basename "$(dirname "$o")"); c=$(commit_of "$o"); up=$(name_of "$o"); into=$(into_of "$o"); lb=$(local_of "$o")
	G=$(clone_for "$up")
	[ -n "$G" ] || { echo "$part: not checked, no clone of $up here"; unchecked=1; continue; }
	if [ "${CMD:-}" = verify ]; then
		git -C "$G" cat-file -e "$c^{commit}" 2>/dev/null || { echo "$part: upstream clone lacks commit $c"; rc=1; continue; }
		nfrom=$(grep -c '^\[\[lift.from\]\]' "$o")
		each_range "$o" | while read -r f b s e; do
			have=$(git -C "$G" rev-parse "$c:$f" 2>/dev/null || echo none)
			[ "$have" = "$b" ] || { echo "$part: WRONG $f recorded $b, upstream has $have"; exit 1; }
			# lifted whole: the file here must be that blob, untouched
			local=""
			if [ "$into" = . ]; then local="lifted/$part/$f"
			elif [ "$nfrom" -eq 1 ] && [ "$s" -eq 1 ] && [ "$e" -eq "$(git -C "$G" show "$c:$f" | awk 'END { print NR }')" ]; then local="lifted/$part/$into"; fi
			if [ -n "$local" ] && [ -n "$lb" ] && [ "$into" != . ]; then
				# lifted whole, then changed as its [cut] records: the file here must be that recorded blob
				[ -f "$local" ] || { echo "$part: WRONG $local is missing"; exit 1; }
				[ "$(git hash-object "$local")" = "$lb" ] || { echo "$part: WRONG $local is neither upstream's $f nor the change its record names"; exit 1; }
				echo "$part: ok   $f whole, changed as recorded"
			elif [ -n "$local" ]; then
				[ -f "$local" ] || { echo "$part: WRONG $local is missing"; exit 1; }
				[ "$(git hash-object "$local")" = "$b" ] || { echo "$part: WRONG $local is not upstream's $f, byte for byte"; exit 1; }
				echo "$part: ok   $f whole, untouched"
			else
				echo "$part: ok   $f $s-$e"
			fi
		done || rc=1
	else
		each_range "$o" | while read -r f b s e; do
			git -C "$G" log --format="$part: moved $f $s-$e  %h %cs %s" -L "$s,$e:$f" "$c..HEAD" 2>/dev/null | grep "^$part: moved" || true
		done
	fi
done
[ $rc -ne 0 ] && exit $rc
[ $unchecked -eq 0 ] || exit 2
exit 0
