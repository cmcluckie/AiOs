# TST.machine.irq-only@1, run by jig/test as: sh this QTREE
# Green when the paused share machine holds one serial port, one 8254, the
# 8259 pair, and nothing that is not on SPEC.machine.4@1's list of what microvm forces.
cap=$1
grep -q 'dev: ' "$cap" || { echo "no device tree came back"; exit 1; }
bad=$(sed -n 's/^ *dev: \([^,]*\),.*/\1/p' "$cap" | grep -v -x -e isa-serial -e isa-pit -e kvm-pit -e isa-i8259 -e kvm-i8259 -e isabus-bridge -e ioapic -e fw_cfg_io -e kvmclock -e kvmvapic -e virtio-mmio | sort -u | tr '\n' ' ')
[ -z "$bad" ] || { echo "unexpected devices: $bad"; exit 1; }
[ "$(grep -c 'dev: isa-serial,' "$cap")" -eq 1 ] || { echo "not exactly one serial port"; exit 1; }
[ "$(grep -c -e 'dev: isa-pit,' -e 'dev: kvm-pit,' "$cap")" -eq 1 ] || { echo "not exactly one 8254 timer"; exit 1; }
[ "$(grep -c -e 'dev: isa-i8259,' -e 'dev: kvm-i8259,' "$cap")" -eq 2 ] || { echo "not the two 8259s"; exit 1; }
[ "$(grep -c 'dev: virtio-mmio,' "$cap")" -le 8 ] || { echo "more than eight virtio-mmio transports"; exit 1; }
echo "$(grep -c 'dev: ' "$cap") devices: the serial port, the 8254, the two 8259s, and what microvm forces"
