# TST.timer.rate@1, run by jig/test as: sh this STAMPED-CAPTURE SECONDS
# The ms door's only idea of a second is the rate PART.timer.tsc-pit measured.
# Green when that rate was measured at all (the door is not 0 forever) and the
# door keeps pace with the host's clock to within 1%, as loader.ms@1 checks.
# A machine that printed nothing did not measure 0: it died or hung before the
# probe's first line, and says so, so whoever wrote the part looks for a crash and
# not for a clock (findings 0033).  A door stuck at 0 prints one line, "0": the
# probe prints only when the door has moved on (findings 0034).
[ -s "$1" ] || { echo "the machine printed nothing in its ${2:-?} seconds: it died or hung before the program's first line"; exit 1; }
grep -q ' [1-9][0-9]*$' "$1" || { echo "the door said 0 throughout: the rate was never measured"; exit 1; }
sh "$(dirname "$0")/loader.ms@1.check" "$@"
